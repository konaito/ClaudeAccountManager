#!/bin/bash
# cam: Claude Account Manager
# 1つの Mac で Claude Code をアカウントごとのコマンド（ceo, cto ...）で並べて起動する。
# 公式の CLAUDE_CONFIG_DIR を使う。ログイン（Keychain）だけ別で、
# ~/.claude の中身はアカウントごとの値を除いて全部リンクで共有し、
# ユーザー MCP（~/.claude.json の mcpServers）と信頼済みフォルダは起動のたびに同期する。
# 共有リストは Nael-Nathanael/ccd（MIT）を参考にした。
set -euo pipefail

MASTER="$HOME/.claude"
MASTER_JSON="$HOME/.claude.json"
CAM_HOME="$HOME/.cam"
PROFILES="$CAM_HOME/profiles"
BIN="$CAM_HOME/bin"

# ~/.claude の中身は、下の PER_ACCOUNT に当たるもの以外を全部リンクで共有する。
# sessions も共有するので、どのアカウントのセッションからも ListAgents と SendMessage で互いが見える。
# アカウントごとに分けるもの: ログイン（Keychain）、.claude.json（プロファイル直下。mcpServers と信頼済みフォルダだけ同期）、
# 組織ごとの値（policy-limits.json・remote-settings.json）、MCP の認証状態、.claude.json の控え（backups）。
PER_ACCOUNT=(.claude.json .credentials.json .credentials.lock mcp-needs-auth-cache.json backups
             'policy-limits.json*' 'remote-settings.json*' '*.bak' '*.bak-*' '*.tmp.*' .DS_Store)
# Claude Code が起動後に作るフォルダ。~/.claude に先に作っておき、プロファイルに実体ができる前にリンクを張る。
RUNTIME_DIRS=(sessions session-env shell-snapshots teams tasks todos jobs ide debug paste-cache telemetry cache)

die() { echo "cam: $*" >&2; exit 1; }

valid_name() {
    [[ "$1" =~ ^[a-z][a-z0-9_-]*$ ]] || die "名前は英小文字で始まる英数字・-・_ にしてください: $1"
}

per_account() {
    local pat
    for pat in "${PER_ACCOUNT[@]}"; do
        # shellcheck disable=SC2053
        [[ "$1" == $pat ]] && return 0
    done
    return 1
}

# プロファイルに実体があるものを ~/.claude 側へ移してからリンクにする。
# フォルダは中身を1つずつ移し、~/.claude に同じ名前があるものは捨てずに .cam-replaced/<時刻>/ に残す。
# ファイルは丸ごと .cam-replaced/<時刻>/ に残す。動いているセッションのファイルも、移した先をリンク経由で使い続ける。
adopt() {
    local dir="$1" f="$2" src="$1/$2" dst="$MASTER/$2" keep c
    keep="$dir/.cam-replaced/$(date +%Y%m%d-%H%M%S)"
    if [[ -d "$src" && -d "$dst" ]]; then
        shopt -s nullglob dotglob
        for c in "$src"/*; do
            if [[ -e "$dst/$(basename "$c")" || -L "$dst/$(basename "$c")" ]]; then
                mkdir -p "$keep/$f"
                mv "$c" "$keep/$f/"
            else
                mv "$c" "$dst/"
            fi
        done
        shopt -u nullglob dotglob
        rmdir "$src"
    else
        mkdir -p "$keep"
        mv "$src" "$keep/"
    fi
    ln -s "$dst" "$src"
    echo "cam: $(basename "$dir")/$f を ~/.claude/$f へのリンクにしました" >&2
}

# プロファイルの共有リンクを張り直し、mcpServers と信頼済みフォルダを同期する
sync_profile() {
    local name="$1" dir="$PROFILES/$1" f d
    [[ -d "$dir" ]] || die "プロファイルがありません: $name"
    for d in "${RUNTIME_DIRS[@]}"; do
        [[ -e "$MASTER/$d" ]] || mkdir -p "$MASTER/$d"
    done
    shopt -s nullglob dotglob
    local entries=("$MASTER"/*)
    shopt -u nullglob dotglob
    for f in "${entries[@]}"; do
        f=$(basename "$f")
        per_account "$f" && continue
        if [[ -L "$dir/$f" ]]; then
            continue
        elif [[ -e "$dir/$f" ]]; then
            adopt "$dir" "$f"
        else
            ln -s "$MASTER/$f" "$dir/$f"
        fi
    done
    sync_claude_json "$dir"
}

# 信頼済みのフォルダ（.claude.json の projects[パス].hasTrustDialogAccepted）を、
# ~/.claude.json と全プロファイルから集めて重複を除き、JSON の配列で出す。読めないファイルは飛ばす。
trusted_dirs() {
    local f
    for f in "$MASTER_JSON" "$PROFILES"/*/.claude.json; do
        [[ -f "$f" ]] || continue
        jq -c '[.projects // {} | to_entries[] | select(.value.hasTrustDialogAccepted == true) | .key]' "$f" 2>/dev/null || true
    done | jq -sc 'add // [] | unique'
}

# プロファイルの .claude.json に、~/.claude.json の mcpServers と、
# どれかのアカウントで信頼したフォルダを写す。変わるときだけ書き換える。
sync_claude_json() {
    local dir="$1" pj="$1/.claude.json" mcp trusted cur new tmp
    if [[ -f "$MASTER_JSON" ]]; then
        mcp=$(jq -c '.mcpServers // {}' "$MASTER_JSON" 2>/dev/null) || mcp=null
    else
        mcp=null
    fi
    trusted=$(trusted_dirs)
    if [[ -f "$pj" ]]; then
        cur=$(jq -c . "$pj" 2>/dev/null) || { echo "cam: $pj を読めないので MCP と信頼済みフォルダは同期しません" >&2; return 0; }
    else
        cur='{}'
    fi
    new=$(jq -c --argjson m "$mcp" --argjson t "$trusted" '
        (if $m == null then . else .mcpServers = $m end)
        | reduce $t[] as $p (.; .projects[$p].hasTrustDialogAccepted = true)' <<<"$cur")
    [[ "$new" == "$cur" && -f "$pj" ]] && return 0
    tmp=$(mktemp "$dir/.claude.json.cam.XXXXXX")
    jq . <<<"$new" >"$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$pj"
}

write_launcher() {
    local name="$1" mode="$2" out="$BIN/$1"
    if [[ "$mode" == default ]]; then
        cat >"$out" <<EOF
#!/bin/bash
# cam: $name は ~/.claude（既定のログイン）で起動する
exec claude "\$@"
EOF
    else
        cat >"$out" <<EOF
#!/bin/bash
# cam: $name は ~/.cam/profiles/$name で起動する
"$BIN/cam" sync "$name" || true
CLAUDE_CONFIG_DIR="$PROFILES/$name" exec claude "\$@"
EOF
    fi
    chmod +x "$out"
}

# プロファイルで claude auth login を実行し、通ったら claude を起動する
login_and_launch() {
    local name="$1"
    [[ -d "$PROFILES/$name" ]] || die "プロファイルがありません: ${name}（--default のコマンドは ~/.claude のログインを使う）"
    if ! [[ -t 0 && -t 1 ]]; then
        echo "端末から '$name' を起動し、/login でこのアカウントにログインしてください"
        return 0
    fi
    echo "${name} のアカウントでログインします（ブラウザが開きます）"
    if ! CLAUDE_CONFIG_DIR="$PROFILES/$name" claude auth login; then
        die "ログインできませんでした。'cam add $name' でやり直すか、'$name' を起動して /login してください"
    fi
    exec "$BIN/$name"
}

cmd_add() {
    local name="" mode=profile login=1 a
    for a in "$@"; do
        case "$a" in
            --default) mode=default ;;
            --no-login) login=0 ;;
            -*) die "知らないオプションです: $a" ;;
            *) [[ -z "$name" ]] || die "使い方: cam add <名前> [--default] [--no-login]"; name="$a" ;;
        esac
    done
    [[ -n "$name" ]] || die "使い方: cam add <名前> [--default] [--no-login]"
    valid_name "$name"
    [[ "$name" == cam ]] && die "cam は使えません"
    if [[ -e "$BIN/$name" ]]; then
        # 既にあるコマンドは、そのアカウントのログインし直しとして扱う
        [[ -d "$PROFILES/$name" ]] || die "${name} は ~/.claude のログインで起動するコマンドです。ログインし直すなら '$name' を起動して /login してください"
        [[ "$mode" == profile ]] || die "${name} はプロファイルのコマンドです（--default は付けられません）"
        if [[ "$login" == 1 ]]; then
            login_and_launch "$name"
        else
            echo "${name} はもうあります（cam list）"
        fi
        return 0
    fi
    local other
    other=$(PATH="${PATH//$BIN:/}" command -v "$name" 2>/dev/null || true)
    [[ -n "$other" ]] && die "$name は既存のコマンド（${other}）と同じ名前です"
    mkdir -p "$BIN"
    if [[ "$mode" == profile ]]; then
        mkdir -p "$PROFILES/$name"
        chmod 700 "$PROFILES/$name"
        sync_profile "$name"
    fi
    write_launcher "$name" "$mode"
    if [[ "$mode" == profile ]]; then
        echo "作成: ${name}（~/.cam/profiles/${name}）"
        if [[ "$login" == 1 ]]; then
            login_and_launch "$name"
        else
            echo "次に 'cam add $name' をもう一度実行するか、'$name' を起動して /login でログインしてください"
        fi
    else
        echo "作成: ${name}（~/.claude のログインで起動）"
    fi
}

account_of() {
    local j="$1"
    [[ -f "$j" ]] || { echo "未ログイン"; return; }
    jq -r '.oauthAccount.emailAddress // "未ログイン"' "$j" 2>/dev/null || echo "?"
}

cmd_list() {
    local f name
    shopt -s nullglob
    for f in "$BIN"/*; do
        name=$(basename "$f")
        [[ "$name" == cam ]] && continue
        if [[ -d "$PROFILES/$name" ]]; then
            printf '%-10s %s\n' "$name" "$(account_of "$PROFILES/$name/.claude.json")"
        else
            printf '%-10s %s（~/.claude）\n' "$name" "$(account_of "$MASTER_JSON")"
        fi
    done
}

cmd_remove() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "使い方: cam remove <名前>"
    valid_name "$name"
    [[ -e "$BIN/$name" ]] || die "$name はありません"
    rm -f "$BIN/$name"
    if [[ -d "$PROFILES/$name" ]]; then
        # リンク先（~/.claude）は消さない。プロファイル内の実体だけ消える
        rm -rf "${PROFILES:?}/$name"
        echo "削除: ${name}（Keychain に残るこのプロファイルのログイン情報は消していません）"
    else
        echo "削除: $name"
    fi
}

# Claude Code がそのコマンドのログインを置く Keychain の項目から OAuth のアクセストークンを読む。
# CLAUDE_CONFIG_DIR を付けると項目名に sha256(パス) の先頭8桁が付く（ceo で確認）。
token_of() {
    local name="$1" svc="Claude Code-credentials"
    if [[ -d "$PROFILES/$name" ]]; then
        svc+="-$(printf %s "$PROFILES/$name" | shasum -a 256 | cut -c1-8)"
    fi
    security find-generic-password -s "$svc" -w 2>/dev/null \
        | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null || true
}

# 使用率を API から取り、「状態 5h 7d 5hのリセット 7dのリセット」で出す。
# 状態は ok（取れた）、limited（429 で断られた）、notoken（トークンが無いか期限切れ）、error（それ以外）。
# ok 以外は数値の欄が「- - 0 0」になる。リセット時刻は epoch 秒で、不明は 0。
# /api/oauth/usage は公開されていない API で、低い頻度でも 429 を返すことがある。
usage_of() {
    local tok res code body line
    tok=$(token_of "$1")
    [[ -n "$tok" ]] || { echo "notoken - - 0 0"; return 0; }
    res=$(curl -s -m 5 -w '\n%{http_code}' https://api.anthropic.com/api/oauth/usage \
        -H "Authorization: Bearer $tok" -H "anthropic-beta: oauth-2025-04-20" 2>/dev/null) || res=$'\n000'
    code=${res##*$'\n'}
    body=${res%$'\n'*}
    case "$code" in
        200) ;;
        429) echo "limited - - 0 0"; return 0 ;;
        401) echo "notoken - - 0 0"; return 0 ;;
        *) echo "error - - 0 0"; return 0 ;;
    esac
    line=$(jq -r 'def epoch: try (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) catch 0;
                  select(.five_hour.utilization != null)
                  | "ok \(.five_hour.utilization) \(.seven_day.utilization // 0)"
                    + " \(.five_hour.resets_at | epoch) \(.seven_day.resets_at | epoch)"' <<<"$body" 2>/dev/null)
    echo "${line:-error - - 0 0}"
}

# 前回取れた使用率の控え。1行「5h 7d 5hのリセット 7dのリセット 取った時刻」で、コマンドごとに1ファイル。
USAGE_CACHE="$CAM_HOME/usage-cache"

# 1コマンドぶんの行「名前 状態 5h 7d 5hのリセット 7dのリセット 値の時刻」を出す。
# 取れたら控えを書き、取れなければ控えを状態 cached で出す。
# 控えのリセット時刻を過ぎた枠は、使用率を 0、リセット時刻を不明にする。
usage_row() {
    local name="$1" now st five seven r5 r7 at tmp
    now=$(date +%s)
    read -r st five seven r5 r7 <<<"$(usage_of "$name")"
    if [[ "$st" == ok ]]; then
        mkdir -p "$USAGE_CACHE"
        tmp=$(mktemp "$USAGE_CACHE/.$name.XXXXXX")
        echo "$five $seven $r5 $r7 $now" >"$tmp"
        mv "$tmp" "$USAGE_CACHE/$name"
        echo "$name ok $five $seven $r5 $r7 $now"
        return 0
    fi
    if [[ -f "$USAGE_CACHE/$name" ]] \
        && read -r five seven r5 r7 at <"$USAGE_CACHE/$name" && [[ -n "$at" ]]; then
        if [[ "$r5" -gt 0 && "$r5" -le "$now" ]]; then five=0; r5=0; fi
        if [[ "$r7" -gt 0 && "$r7" -le "$now" ]]; then seven=0; r7=0; fi
        echo "$name cached $five $seven $r5 $r7 $at"
        return 0
    fi
    echo "$name $st - - 0 0 0"
}

# リセット時刻（epoch 秒）をこの Mac の時刻で出す。不明なら「?」
until_of() {
    if [[ "${1:-0}" -gt 0 ]]; then date -r "$1" "+$2"; else echo '?'; fi
}

# コマンドごとの使用率を usage_row の形で1行ずつ出す。
# API は全コマンド同時に呼び、並びはコマンド順に戻す。
collect_usage() {
    local f name tmp i=0 j
    tmp=$(mktemp -d)
    shopt -s nullglob
    for f in "$BIN"/*; do
        name=$(basename "$f")
        [[ "$name" == cam ]] && continue
        i=$((i + 1))
        usage_row "$name" >"$tmp/$i" &
    done
    wait
    for ((j = 1; j <= i; j++)); do cat "$tmp/$j"; done
    rm -rf "$tmp"
}

# 判定できないときの行き先: --default のコマンド、無ければ最初のコマンド
fallback_of() {
    local name fallback=""
    while read -r name _; do
        if [[ -z "$fallback" ]] || [[ -d "$PROFILES/$fallback" && ! -d "$PROFILES/$name" ]]; then
            fallback="$name"
        fi
    done
    echo "$fallback"
}

# 5時間枠の使用率がいちばん低いコマンド。同じなら7日枠の低いほう。
# どちらかの枠が 100% のコマンドと、使用率が取れず控えも無いコマンドは選ばない。
# 控え（cached）の値も、取れた値と同じに扱う。
best_of() {
    awk '($2 == "ok" || $2 == "cached") && $3 < 100 && $4 < 100' | sort -k3,3g -k4,4g | head -n1 | awk '{print $1}'
}

# 使用率が取れないときの理由
reason_of() {
    case "$1" in
        limited) echo "API に断られた（429）。しばらくすると取れる" ;;
        notoken) echo "トークンが無いか期限切れ。一度 $2 を起動すると更新される" ;;
        *) echo "API から取れなかった" ;;
    esac
}

print_usage_rows() {
    local name st five seven r5 r7 at note
    while read -r name st five seven r5 r7 at; do
        [[ -n "$name" ]] || continue
        if [[ "$st" != ok && "$st" != cached ]]; then
            printf '  %-10s 不明（%s）\n' "$name" "$(reason_of "$st" "$name")"
            continue
        fi
        note=""
        [[ "$st" == cached ]] && note="  ※ $(date -r "$at" '+%H:%M') 時点の値（API から取れなかった）"
        printf '  %-10s 5h %5.1f%%（%s まで）  7d %5.1f%%（%s まで）%s\n' \
            "$name" "$five" "$(until_of "$r5" '%H:%M')" "$seven" "$(until_of "$r7" '%-m/%-d %H:%M')" "$note"
    done
}

# メニューバーのアプリが読む JSON。
# status は ok・cached・limited・notoken・error。as_of は値を取った時刻（epoch 秒）。
# 使用率が取れず控えも無いコマンドは five_hour などが null になる。
usage_json() {
    local rows="$1" best="$2" name st five seven r5 r7 at email
    while read -r name st five seven r5 r7 at; do
        [[ -n "$name" ]] || continue
        if [[ -d "$PROFILES/$name" ]]; then
            email=$(account_of "$PROFILES/$name/.claude.json")
        else
            email=$(account_of "$MASTER_JSON")
        fi
        jq -n --arg name "$name" --arg email "$email" --arg st "$st" --arg reason "$(reason_of "$st" "$name")" \
            --arg five "$five" --arg seven "$seven" --arg r5 "$r5" --arg r7 "$r7" --arg at "$at" \
            'def num: if . == "" or . == "-" then null else tonumber end;
             def at: if . == "" or . == "0" then null else tonumber end;
             {name: $name, email: $email, status: $st,
              reason: (if $st == "ok" or $st == "cached" then null else $reason end),
              as_of: ($at | at),
              five_hour: ($five | num), seven_day: ($seven | num),
              five_hour_resets_at: ($r5 | at), seven_day_resets_at: ($r7 | at)}'
    done <<<"$rows" | jq -s --arg best "$best" --argjson now "$(date +%s)" \
        '{best: (if $best == "" then null else $best end), fetched_at: $now, accounts: .}'
}

cmd_usage() {
    local rows best
    rows=$(collect_usage)
    best=$(best_of <<<"$rows")
    if [[ "${1:-}" == --json ]]; then
        usage_json "$rows" "$best"
        return 0
    fi
    [[ -n "$rows" ]] || die "コマンドがありません（cam add）"
    print_usage_rows <<<"$rows"
    echo "cam auto: ${best:-（判定できない）}"
}

# 5時間枠の使用率がいちばん低いコマンドで、何も表示せずに起動する。
cmd_auto() {
    local rows best
    rows=$(collect_usage)
    [[ -n "$rows" ]] || die "コマンドがありません（cam add）"
    best=$(best_of <<<"$rows")
    if [[ -z "$best" ]]; then
        best=$(fallback_of <<<"$rows")
        echo "cam: 使えるアカウントが判定できないので $best で起動します" >&2
        print_usage_rows <<<"$rows" >&2
    fi
    exec "$BIN/$best" "$@"
}

case "${1:-}" in
    add) shift; cmd_add "$@" ;;
    auto) shift; cmd_auto "$@" ;;
    usage) shift; cmd_usage "$@" ;;
    list|ls) cmd_list ;;
    sync) shift; [[ -n "${1:-}" ]] || die "使い方: cam sync <名前>"; sync_profile "$1" ;;
    remove|rm) shift; cmd_remove "$@" ;;
    *) cat <<EOF
cam: Claude Code をアカウントごとのコマンドで起動する
  cam add <名前>            プロファイルと <名前> コマンドを作り、ログインして起動する
                            （既にあれば、そのアカウントでログインし直して起動する）
  cam add <名前> --default  ~/.claude のログインで起動する <名前> コマンドを作る
  cam add <名前> --no-login 作るだけでログインと起動はしない
  cam list                  コマンドとログイン中のアカウント
  cam auto [引数]           5時間枠の使用率がいちばん低いコマンドで起動する
  cam usage [--json]        各コマンドの使用率と、cam auto が選ぶコマンド
  cam sync <名前>           共有リンクと MCP を同期（起動時に自動で行う）
  cam remove <名前>         コマンドとプロファイルを消す
EOF
    ;;
esac
